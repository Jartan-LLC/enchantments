{
  "trixie": {
    "image": "mcr.microsoft.com/devcontainers/base:trixie",
    "features": {
      "claude-code": {}
    }
  },
  "native-update": {
    "image": "mcr.microsoft.com/devcontainers/base:trixie",
    "features": {
      "claude-code": {}
    }
  },
  "seeded-volume": {
    "image": "mcr.microsoft.com/devcontainers/base:trixie",
    "initializeCommand": "docker run --rm -v claude-data:/v alpine touch /v/.seed",

{
  "authless": {
    "image": "mcr.microsoft.com/devcontainers/base:trixie",
    "features": {
      "ghcr.io/devcontainers/features/github-cli:1": {},
      "gh-config": {}
    }
  },
  "bare": {
    "image": "mcr.microsoft.com/devcontainers/base:trixie",
    "features": {
      "gh-config": {}
    }
  },
  "foreign-volume": {
    "image": "mcr.microsoft.com/devcontainers/base:trixie",
    "initializeCommand": "docker run --rm -v gh-config:/v alpine sh -c \"touch /v/theirs && chown -R 4242 /v && chmod 700 /v\"",
    "features": {
      "gh-config": {}
    }
  }
}

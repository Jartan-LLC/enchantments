{
  "id": "container-env",
  "version": "1.0.0",
  "name": "Per-device environment variables",
  "description": "Exports per-device environment variables, kept in the container-env volume, into login shells and VS Code, so no repo holds them.",
  "documentationURL": "https://github.com/Jartan-LLC/enchantments/tree/main/src/container-env",
  "licenseURL": "https://github.com/Jartan-LLC/enchantments/blob/main/LICENSE",
  "mounts": [
    {
      "source": "container-env",
      "target": "/mnt/enchantments/container-env",
      "type": "volume"
    }
  ],
  "onCreateCommand": "f=/usr/local/share/enchantments/container-env/onCreate.sh; [ -f \"$f\" ] && command -v bash >/dev/null && bash \"$f\"; exit 0",
  "postStartCommand": "f=/usr/local/share/enchantments/container-env/postStart.sh; [ -f \"$f\" ] && command -v bash >/dev/null && bash \"$f\"; exit 0"
}

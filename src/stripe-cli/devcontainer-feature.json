{
  "id": "stripe-cli",
  "version": "1.0.0",
  "name": "Stripe CLI",
  "description": "Installs the Stripe CLI from a pinned release, and keeps its login in the stripe-config volume, so it survives rebuilds and is shared by every container that mounts it.",
  "documentationURL": "https://github.com/Jartan-LLC/enchantments/tree/main/src/stripe-cli",
  "licenseURL": "https://github.com/Jartan-LLC/enchantments/blob/main/LICENSE",
  "mounts": [
    {
      "source": "stripe-config",
      "target": "/mnt/enchantments/stripe-config",
      "type": "volume"
    }
  ],
  "onCreateCommand": "f=/usr/local/share/enchantments/stripe-cli/onCreate.sh; [ -f \"$f\" ] && command -v bash >/dev/null && bash \"$f\"; exit 0",
  "postStartCommand": "f=/usr/local/share/enchantments/stripe-cli/postStart.sh; [ -f \"$f\" ] && command -v bash >/dev/null && bash \"$f\"; exit 0"
}
